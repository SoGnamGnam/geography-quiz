{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2024",
    "lib": ["ES2024", "ESNext.Collection"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // Node-side code: the data pipeline and every unit test, plus the pure
  // modules they import (domain and engine must not need the DOM either).
  "include": ["scripts/**/*.ts", "src/**/*.test.ts", "src/domain/**/*.ts", "src/engine/**/*.ts"]
}
